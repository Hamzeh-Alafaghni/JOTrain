@{
}
@model JOTrain.Models.Trip

<h2 class="mt-4">Book Your Trip</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm w-50 mt-3">
    <div class="card-body">
        <h5 class="card-title text-primary">@Model.DepartureStation?.Name ➡️ @Model.ArrivalStation?.Name</h5>
        <p class="card-text text-muted mb-4">Departure: @Model.DepartureTime.ToString("g")</p>

        <form asp-action="BookTicket" method="post">
            <input type="hidden" name="tripId" value="@Model.Id" />

            <div class="mb-3">
                <label class="fw-bold">Select Seat Class</label>
                <select name="seatClass" class="form-select" required>
                    <option value="Economy">Economy (@Model.PriceEconomy JOD)</option>
                    <option value="EconomyPlus">Economy+ (@Model.PriceEconomyPlus JOD)</option>
                    <option value="VIP">VIP (@Model.PriceVIP JOD)</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="fw-bold">Payment Method</label>
                <select name="paymentVia" class="form-select" required>
                    <option value="CreditCard">Credit Card</option>
                    <option value="PayPal">PayPal</option>
                    <option value="Cash">Cash at Station</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold py-2">💳 Pay & Book Ticket</button>
            <a asp-controller="Trips" asp-action="Index" class="btn btn-secondary w-100 mt-2">Cancel</a>
        </form>
    </div>
</div>