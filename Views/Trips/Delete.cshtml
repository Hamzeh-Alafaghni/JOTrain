@{
}

@model JOTrain.Models.Trip

<h2 class="mt-4 text-danger">Cancel Scheduled Trip</h2>
<h4 class="mt-3">Are you sure you want to permanently delete this trip?</h4>

<div class="card w-50 mt-4 shadow-sm border-danger">
    <div class="card-body">
        <h5 class="card-title">@Model.DepartureStation?.Name to @Model.ArrivalStation?.Name</h5>
        <p class="card-text mt-3">
            <strong>Departure Time:</strong> @Model.DepartureTime.ToString("f")
        </p>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Yes, Delete Trip</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>